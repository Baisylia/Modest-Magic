{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${credits}"
  ],
  "contact": {
    "homepage": "https://github.com/Baisylia/Modest-Magic",
    "sources": "https://github.com/Baisylia/Modest-Magic",
    "issues": "https://github.com/Baisylia/Modest-Magic/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.baisylia.modestmagic.ModestMagic"
    ],
    "client": [
      "com.baisylia.modestmagic.client.ModestMagicClient"
    ],
    "modmenu": [
      "com.baisylia.modestmagic.compat.ModMenuIntegration"
    ],
    "rrv_client": [
      "com.baisylia.modestmagic.integration.rrv.ModestMagicRrvPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=25"
  }
}